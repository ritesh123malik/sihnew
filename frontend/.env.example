# Sonaris frontend — copy to frontend/.env before starting or building Vite.
VITE_API_URL=http://localhost:8000
# Optional complete WebSocket endpoint; otherwise derived from VITE_API_URL.
# VITE_WS_URL=ws://localhost:8000/ws/waterfall

# Optional public Supabase settings. Never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
