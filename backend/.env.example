# Sonaris backend settings are loaded from .env in the working directory.
# Recommended: run from the repository root and copy the ROOT .env.example.
# This abbreviated template applies only when starting from backend/.
MODEL_PROVIDER=sonar
MODEL_VERSION=colab-best
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
