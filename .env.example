# Sonaris backend — copy to .env at the repository root.
# Start the API from the repository root so relative paths remain consistent.
MODEL_PROVIDER=sonar
MODEL_PATH=model/best.pt
MODEL_VERSION=colab-best
DATABASE_URL=sqlite:///./sonar_sentry.db
MAX_FILE_SIZE_MB=500
SSS_ENABLE_PROCESSING=true
SSS_ENABLE_BAC=true
SSS_ENABLE_STRIPE_FILTER=true
SSS_ENABLE_SHARPENING=true
SSS_ENABLE_SHADOW_INPAINTING=false

# Optional cloud integration. Leave empty for local operation.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# main.py defaults these to 1 and 0. Docker env_file also exports them.
YOLO_OFFLINE=1
ULTRALYTICS_AUTOINSTALL=0

# Frontend values belong in frontend/.env, not this file.
# Direct os.environ switches such as USE_DGRM, USE_SADH, WATCHDOG_DISABLE,
# and XTF_TILE_* must be exported in the process environment. See docs/configuration.md.
